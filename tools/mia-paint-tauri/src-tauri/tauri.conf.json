{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIA Paint",
  "version": "0.1.0",
  "identifier": "cz.mia.paint",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "../ui/shell.html",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MIA Paint",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "url": "shell.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' http://127.0.0.1:* ws://127.0.0.1:*; frame-src http://127.0.0.1:*; connect-src http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ]
  }
}
