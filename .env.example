# =============================================================================
# MIA — .env.example (zkopíruj do .env a uprav)
# =============================================================================

# --- TTS (Edge) ---
MIA_TTS_EDGE_VOICE=cs-CZ-VlastaNeural
MIA_TTS_EDGE_RATE_MIA=-28%
MIA_TTS_EDGE_PITCH_MIA=+16Hz
MIA_TTS_EDGE_VOLUME_MIA=+0%

MIA_TTS_EDGE_VOICE_KOJ=cs-CZ-AntoninNeural
MIA_TTS_EDGE_RATE_KOJ=+32%
MIA_TTS_EDGE_PITCH_KOJ=-32Hz
MIA_TTS_EDGE_VOLUME_KOJ=+4%

# --- LLM (volitelné) ---
# Hybrid s auto-přepínáním: MIA zkusí primární provider, při 429/výpadku přepne na další.
# MIA_LLM_PROVIDER=groq            # primární: groq (free) | openai | ollama
# MIA_LLM_MODE=hybrid
# MIA_LLM_FALLBACK=groq,openai     # pořadí přepínání (default: groq,openai,ollama)
# GROQ_API_KEY=gsk_...             # https://console.groq.com/keys (zdarma)
# MIA_LLM_MODEL_GROQ=llama-3.3-70b-versatile
# OPENAI_API_KEY=sk-...
# MIA_LLM_MODEL_OPENAI=gpt-4o-mini
# Ollama lokálně: MIA_LLM_PROVIDER=ollama + ollama pull llama3.2

# --- Telegram (User Mode messaging, oddělené od streamu) ---
# 1) @BotFather → /newbot → token
# 2) MIA_TELEGRAM_ENABLED=1
# MIA_TELEGRAM_BOT_TOKEN=
# MIA_TELEGRAM_ALLOWED_USER_IDS=123456789
# MIA_TELEGRAM_STREAMER_ONLY=1
# npm run telegram:setup

# --- Solo stream (tichý chat → MIA vede show) ---
# MIA_QUIET_BEHAVIOR=solo_stream
# MIA_PROACTIVE_HOST=on
# MIA_SOLO_STREAM_ENABLED=on
# MIA_SOLO_STREAM_OBS_SCENE_SWITCH=on
# MIA_SOLO_STREAM_MAIN_SCENE=SPINAK_ENGINE_GIFTS
# MIA_SOLO_STREAM_SCENE_IDLE=SPINAK_AFK
# MIA_SOLO_STREAM_SCENE_LOBBY=SPINAK_LOBBY
# MIA_SOLO_STREAM_SCENE_MIA=MIA_HOST_SCENE
# MIA_SOLO_STREAM_EXIT_CHAT_MS=8000
# MIA_SOLO_STREAM_MIN_SCENE_HOLD_MS=45000
# MIA_SOLO_STREAM_CONFIG_PATH=config/solo-stream.json

# --- NEJSEM TU / away host ---
# MIA_WORLD_MODE=default
# MIA_AWAY_SCENE=SPINAK_NEJSEM_TU
# MIA_AWAY_OBS_SCENE_SWITCH=on
# MIA_ECOSYSTEM_ENABLED=on
# Gift chat loop (pet dárky animal_small v NEJSEM TU — legacy název capybara flow)
# MIA_GIFT_CHAT_LOOP=away_only   # default — jen AWAY / solo
# MIA_GIFT_CHAT_LOOP=always      # i během běžného LIVE
# MIA_GIFT_CHAT_LOOP=off
# MIA_CAPYBARA_FLOW=off          # legacy alias pro vypnutí
# Away smyčka: auto = MP4 pokud existuje, jinak browser CSS loop
# MIA_AWAY_LOOP_MODE=auto
# MIA_AWAY_LOOP_MODE=browser
# MIA_AWAY_LOOP_MODE=video
# MIA_AWAY_LOOP_VIDEO=incoming-images/videos/away/nejsem_tu_loop.mp4
# OBS Ninja embed (view URL) — zobrazí se v MIA_HOST_MODE overlay během AWAY
# MIA_OBS_NINJA_URL=https://vdo.ninja/?view=YOUR_ROOM
# MIA obs ruce pro away scénu (default on; vypni = 0)
# MIA_OBS_AWAY_SCENE_HANDS=on

# --- Viewer story + Koj walk (Sprint 3) ---
# MIA_VIEWER_STORY_MIN_TIER=2
# MIA_VIEWER_STORY_FRAME_MS=3800
# MIA_KOJ_WALK_DURATION_MS=45000

# --- T0 engagement (like / follow / share / comment) ---
# MIA_T0_OVERLAY=on
# MIA_T0_LIKE_ACK_EVERY=50
# MIA_T0_FLYBY=on

# --- Host team split (Sprint 5, jen v host modu) ---
# MIA_HOST_TEAM_SPLIT_PCT=50

# --- Gift economy tiering ---
# MIA_GIFT_ECONOMY_TIERS=coins
# coins = prahy 100/1k/5k/10k/25k (MIA_GIFT_TIERS.js)
# legacy = staré miaPoints prahy

# --- Runtime výkon ---
# MIA_OVERLAY_STATE_CACHE_MS=450
# MIA_VOICE_HOLD_MIN_MS=3500
# MIA_VOICE_HOLD_BUFFER_MS=1200
# MIA_VOICE_HOLD_FALLBACK_MS=8500
# MIA_OBS_PERSISTENT_LAYERS_THROTTLE_MS=5000

# --- Bezpečnost (Sprint A) ---
# MIA_BIND_HOST=127.0.0.1
# MIA_INGEST_SECRET=
# MIA_DEBUG_ROUTES=on

# --- Startup check + preflight ---
# MIA_STARTUP_CHECK_MS=120000
# MIA_PREFLIGHT_ON_START=0       ... default: po restartu BEZ testu, jen % pripravenosti
# MIA_PREFLIGHT_MODE=fast        ... jen kdyz MIA_PREFLIGHT_ON_START=1 (~3-4 min)
# MIA_PREFLIGHT_PARALLEL=on        ... paralelni beh i pro full preflight (volitelne)

# --- OBS ---
# OBS_WS_URL=ws://127.0.0.1:4455
# OBS_WS_PASSWORD=
# MIA_OBS_OVERLAY_MODE=split
# MIA_OBS_LAYOUT_LOCKED=true
# MIA OBS Vision — kontinuální sledování scény + auto-layout (TikTok/Kick)
# MIA_OBS_VISION=on
# MIA_OBS_AUTO_LAYOUT=on
# MIA_OBS_VISION_MS=2500
# MIA_STREAM_PLATFORM=auto
# Náhled: http://127.0.0.1:3000/mia-vision-dashboard.html
# MIA_OBS_HANDS=true          ... auto-vytvoření chybějících browser overlay (vypni=0)
# MIA_SELF_RESTART=on         ... po OBS rukou / media apply se MIA sama restartuje
# MIA_SELF_RESTART_DELAY_MS=2500
# MIA_RESTART_HEALTH_MS=15000 ... npm run restart čeká na /health (ms)
# MIA_OBS_VOICE_MONITOR=and_output
# MIA_OBS_CAMERA_SCENE=SPINAK_ENGINE_GIFTS
# MIA_OBS_CAMERA_NAME=NOTEBOOK_CAMERA
# MIA_OBS_PERSISTENT_LAYER_PATTERNS=
# OBS watchdog — když OBS proces spadne (zmizí), MIA ho sama čistě nahodí.
# Řeší tichý výpadek streamu po pádu CEF/ffmpeg na slabém HW.
# OBS_AUTO_LAUNCH=true             ... zapnuto (vypni=false)
# OBS_EXE_PATH=                    ... cesta k obs64.exe (prázdné = auto-detekce Program Files)
# OBS_AUTO_LAUNCH_COOLDOWN_MS=60000 ... min. prodleva mezi pokusy o spuštění
# OBS_AUTO_LAUNCH_MAX_ATTEMPTS=5   ... strop pokusů (brání relaunch smyčce)

# --- TikTok LIVE audio (OBS Virtual Camera neposílá zvuk) ---
# VB-Audio Virtual Cable (nebo jiný virtual audio device):
# 1. OBS → Nastavení → Audio → Monitoring Device = CABLE Input
# 2. MIA_VOICE browser: Advanced Audio → Monitor and Output
# 3. TikTok LIVE Studio → mikrofon = CABLE Output (ne integrovaný mik)
# MIA_TIKTOK_MIC_DEVICE=VB-Audio Virtual Cable Output
# Diagnostika před live: npm run obs:verify-stream-ready

# --- Kick bridge (volitelné) ---
# KICK_CHANNEL=
# KICK_PUSHER_KEY=

# Anti-echo: ztlum Desktop Audio kdyz MIA_VOICE = Monitor+Output
MIA_OBS_VOICE_ANTI_ECHO=1

# --- Phase 4: User Mode stub (default OFF; ne multi-tenant) ---
# MIA_USER_MODE=0
# MIA_USER_MODE=1   ... jen flag/stub, viz docs/MIA_PHASE4_PROGRESS.md
