# =============================================================================
# MIA PC — .env šablona (multi-PC topologie)
# =============================================================================
# Zkopíruj na MIA PC jako `.env` ( vedle index.js ).
# STREAM PC = OBS + TikTok LIVE Studio + TikFinity UI
# MIA PC     = Node + MIA runtime + /ingest + TTS + logy
#
# Po zapojení switche vyplň <STREAM-IP> a <MIA-PC-IP> z tabulky v:
# docs/MIA_MULTI_PC_SETUP.md
# =============================================================================

# --- Síť (MIA musí přijímat ingest z STREAM PC) ---
PORT=3000
MIA_BIND_HOST=0.0.0.0
# Doporučeno na LAN — TikFinity webhook z jiného PC:
# MIA_INGEST_SECRET=<long-random-secret>

# --- OBS (běží na STREAM PC, ne lokálně) ---
OBS_WS_URL=ws://<STREAM-IP>:4455
OBS_WS_PASSWORD=<PASSWORD>
# MIA neukládá OBS na tomto stroji — vypni auto-launch:
OBS_AUTO_LAUNCH=false
# OBS_EXE_PATH=   ... nevyplňovat na MIA PC

# --- TikFinity (UI na STREAM PC → webhook sem) ---
# V TikFinity nastav HTTP endpoint (Connect / webhook):
#   http://<MIA-PC-IP>:3000/ingest
# Volitelně stejná URL pro dokumentaci / bridge skripty:
# MIA_TIKFINITY_INGEST_URL=http://<MIA-PC-IP>:3000/ingest
# MIA_TIKTOK_INGEST_URL=http://<MIA-PC-IP>:3000/ingest

# --- Kick bridge (běží v MIA procesu → lokální ingest) ---
# MIA_KICK_ENABLED=1
# MIA_KICK_INGEST_URL=http://127.0.0.1:3000/ingest

# --- Stream platforma (vizuál / layout) ---
MIA_STREAM_PLATFORM=tiktok
# MIA_OBS_VISION=on
# MIA_OBS_AUTO_LAYOUT=on

# --- Bezpečnost ---
# MIA_DEBUG_ROUTES=0
# Admin/debug jen z CONTROL PC přes SSH tunnel nebo VPN pokud potřeba.

# --- TTS / voice (zkopíruj z .env.example pokud potřeba) ---
MIA_TTS_EDGE_VOICE=cs-CZ-VlastaNeural
MIA_TTS_EDGE_VOICE_KOJ=cs-CZ-AntoninNeural
MIA_OBS_VOICE_ANTI_ECHO=1
MIA_DUAL_VOICE=0

# --- Preflight po migraci (thaw checkpoint) ---
# MIA_PREFLIGHT_ON_START=0

# --- Zbytek runtime ---
# Plný seznam proměnných: .env.example (TTS, LLM, Telegram, solo stream, …)
